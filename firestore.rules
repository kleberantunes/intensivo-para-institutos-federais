rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Função auxiliar para verificar permissão de administrador
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in ['djkleber@gmail.com']
      );
    }

    match /users/{userId} {
      // Leitura de um usuário: o próprio usuário ou o administrador
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Listagem geral de usuários: exclusivamente para o administrador
      allow list: if isAdmin();
      
      // Gravação: administrador pode alterar tudo (incluindo status); usuário pode gravar se não estiver bloqueado
      allow write: if request.auth != null && (
        isAdmin() || 
        (request.auth.uid == userId && (resource == null || resource.data.status != 'blocked'))
      );
    }
  }
}
